# Canonical HTTPS origin for Cloudflare Pages. Set in the deployment environment; do not include a path or trailing slash.
SITE_URL=

# Affiliate IDs are optional and unused by this static site. Never put tokens here.
AMAZON_AFFILIATE_ID=
ALIEXPRESS_AFFILIATE_ID=
AWIN_ID=

# Optional public measurement / Search Console values. Analytics runs only after consent.
ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# Reserved for a future private server integration. These are NOT read by this static site.
# Never put bot credentials in browser code, public files, or this example file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLISH_SECRET=

# Cloudflare Access JWT validation for the private publishing endpoints.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
