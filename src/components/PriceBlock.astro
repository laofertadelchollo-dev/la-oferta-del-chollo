---
import { formatMoney } from '../lib/site';
const { currentPrice, previousPrice, currency = 'EUR' } = Astro.props;
---

<div class="price-block">
  <span class="current-price">{formatMoney(currentPrice, currency)}</span>
  {previousPrice && <span class="previous-price">{formatMoney(previousPrice, currency)}</span>}
</div>
