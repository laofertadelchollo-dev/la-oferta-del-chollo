---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../lib/site';
const isAdminEnabled = import.meta.env.DEV;
---

<Layout title="Administración local" description="Herramienta local para preparar ofertas y exportar el catálogo." noIndex={true}>
  {isAdminEnabled ? (
  <section class="section narrow-section">
    <div class="container admin-shell">
      <span class="eyebrow">Herramienta local</span>
      <h1>Panel de ofertas</h1>
      <div class="admin-local-warning" role="note">
        <strong>Solo para este navegador.</strong> Los cambios se guardan en el almacenamiento local de este dispositivo, no en un servidor. Exporta el JSON y actualiza <code>src/data/offers.json</code> para publicar cambios. El envío a Telegram solo se ofrece para ofertas publicadas, verificadas y con enlace afiliado; no introduzcas secretos aquí.
      </div>
      <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>

      <div class="admin-toolbar">
        <button type="button" id="new-offer" class="primary-btn">Crear oferta</button>
        <button type="button" id="export-offers" class="secondary-btn">Exportar offers.json</button>
        <label class="secondary-btn file-button">
          Importar JSON
          <input type="file" id="import-offers" accept="application/json,.json" />
        </label>
        <button type="button" id="reset-offers" class="secondary-btn">Restablecer ejemplos</button>
        <button type="button" id="telegram-demo-test" class="secondary-btn">Enviar prueba DEMO a Telegram</button>
      </div>

      <div class="admin-grid admin-workspace">
        <form class="admin-form" id="offer-form" novalidate>
          <input type="hidden" id="offer-id" />
          <h2 id="form-heading">Nueva oferta</h2>
          <label>
            <span>Slug (URL limpia)</span>
            <input type="text" id="slug" maxlength="180" />
          </label>
          <button type="button" id="generate-slug" class="secondary-btn">Generar slug desde el título</button>
          <label>
            <span>Producto *</span>
            <input type="text" id="title" maxlength="180" required />
          </label>
          <label>
            <span>Tienda *</span>
            <select id="store-select">
              <option value="">Selecciona una tienda</option>
              <option value="Amazon España">Amazon España</option>
              <option value="AliExpress">AliExpress</option>
              <option value="other">Otra tienda</option>
            </select>
            <input type="text" id="store-custom" maxlength="100" placeholder="Nombre exacto de la tienda" hidden />
          </label>
          <label>
            <span>Vendedor (si se conoce)</span>
            <input type="text" id="seller" maxlength="120" />
          </label>
          <label>
            <span>Categoría *</span>
            <select id="category" required>
              <option value="">Elige una categoría</option>
              {CATEGORIES.map((category) => <option value={category.slug}>{category.label}</option>)}
            </select>
          </label>
          <label>
            <span>Imagen (ruta local o URL https)</span>
            <input type="text" id="image" maxlength="500" placeholder="/images/mi-producto.webp" />
          </label>
          <label>
            <span>Precio actual (€) *</span>
            <input type="number" id="current-price" min="0.01" step="0.01" required />
          </label>
          <label>
            <span>Precio anterior (€)</span>
            <input type="number" id="previous-price" min="0.01" step="0.01" />
          </label>
          <label class="checkbox-row">
            <input type="checkbox" id="previous-price-verified" />
            <span>He comprobado que el precio anterior es una referencia fiable</span>
          </label>
          <p class="muted-text">El descuento se calcula y muestra únicamente con un precio anterior marcado como comprobado y superior al actual.</p>
          <label>
            <span>Cupón</span>
            <input type="text" id="coupon" maxlength="80" />
          </label>
          <label>
            <span>Condiciones (envío, límites o requisitos)</span>
            <textarea id="conditions" rows="3" maxlength="500"></textarea>
          </label>
          <label>
            <span>Resumen original *</span>
            <textarea id="short-description" rows="3" maxlength="280" required></textarea>
          </label>
          <label>
            <span>Descripción editorial original *</span>
            <textarea id="description" rows="6" maxlength="3000" required></textarea>
          </label>
          <label>
            <span>URL de la oferta *</span>
            <input type="url" id="source-url" placeholder="https://..." maxlength="2000" required />
          </label>
          <label>
            <span>URL afiliada (opcional)</span>
            <input type="url" id="affiliate-url" placeholder="https://..." maxlength="2000" />
          </label>
          <label>
            <span>Fecha de publicación (opcional)</span>
            <input type="date" id="published-at" />
          </label>
          <label>
            <span>Fecha de caducidad (opcional)</span>
            <input type="date" id="expires-at" />
          </label>
          <label>
            <span>Estado editorial</span>
            <select id="status">
              <option value="draft">Borrador</option>
              <option value="verified">Verificada (visible)</option>
              <option value="published">Publicada</option>
              <option value="expired">Expirada</option>
            </select>
          </label>
          <label class="checkbox-row">
            <input type="checkbox" id="verified" />
            <span>He comprobado ahora precio, enlace y condiciones</span>
          </label>
          <label class="checkbox-row">
            <input type="checkbox" id="featured" />
            <span>Destacar en portada</span>
          </label>
          <label>
            <span>Etiquetas separadas por comas</span>
            <input type="text" id="tags" maxlength="300" />
          </label>
          <div class="admin-actions">
            <button type="submit" class="primary-btn">Guardar oferta</button>
            <button type="button" id="cancel-edit" class="secondary-btn">Limpiar formulario</button>
          </div>
        </form>

        <aside class="telegram-panel">
          <h2>Borrador para Telegram</h2>
          <p>El borrador usa solo los datos del formulario. No se publica ni se envía a Telegram.</p>
          <textarea id="telegram-output" rows="14" readonly aria-label="Texto de Telegram generado"></textarea>
          <button type="button" id="copy-telegram" class="primary-btn">Copiar texto</button>
          <p id="telegram-status" class="muted-text" role="status" aria-live="polite"></p>
        </aside>
      </div>

      <section class="admin-import" aria-labelledby="import-heading">
        <h2 id="import-heading">Importar ofertas desde JSON</h2>
        <p>Pega un array de ofertas. Se validarán campos, fechas, precios, estados y URLs antes de sustituir el catálogo local.</p>
        <label for="import-json">JSON de ofertas</label>
        <textarea id="import-json" rows="10" spellcheck="false" placeholder='[{"id":"...","title":"..."}]'></textarea>
        <div class="admin-actions">
          <button type="button" id="validate-import" class="secondary-btn">Validar e importar</button>
        </div>
        <p id="import-errors" class="admin-status" role="status" aria-live="polite"></p>
      </section>

      <section class="admin-simulator" aria-labelledby="simulator-heading">
        <h2 id="simulator-heading">Simulador de candidatos · DEMO</h2>
        <p>Los candidatos de prueba recorren scoring y verificación, pero nunca pueden convertirse en ofertas publicadas.</p>
        <button type="button" id="run-simulator" class="secondary-btn">Procesar candidatos DEMO</button>
        <div id="candidate-results" class="candidate-results" aria-live="polite"></div>
      </section>

      <section class="admin-import" aria-labelledby="found-candidates-heading">
        <h2 id="found-candidates-heading">Ofertas encontradas</h2>
        <p>Importa únicamente exportaciones autorizadas de una plataforma o un feed. Los precios, disponibilidad y condiciones no se verifican en vivo; comprueba cada producto manualmente antes de aprobarlo. No se generan enlaces afiliados.</p>
        <div class="candidate-import-controls">
          <label>
            <span>Fuente declarada</span>
            <select id="candidate-source">
              <option value="aliexpress">AliExpress</option>
              <option value="awin">Awin</option>
              <option value="generic">Genérica</option>
              <option value="amazon">Amazon</option>
            </select>
          </label>
          <label>
            <span>Datos de candidatos JSON o CSV</span>
            <input type="file" id="candidate-import-file" accept="application/json,.json,text/csv,.csv" />
          </label>
        </div>
        <p>Usa encabezados/campos comunes:         <code>id, productId, title, store, category, currentPrice, previousPrice, previousPriceVerified, discount, currency, sourceUrl, image, seller, coupon, conditions, available, checkedAt, affiliateUrl, affiliateRequired, expiresAt</code>. El descuento se recalcula y solo se acepta si coincide con un precio anterior marcado como fiable.</p>
        <label for="candidate-import-data">Pegar datos exportados</label>
        <textarea id="candidate-import-data" rows="8" spellcheck="false" placeholder='[{"title":"...","store":"...","category":"tecnologia","currentPrice":29.99,"previousPrice":49.99,"previousPriceVerified":true,"currency":"EUR","sourceUrl":"https://...","conditions":"Sin condiciones especiales","available":true,"checkedAt":"2026-10-01T12:00:00Z","source":"aliexpress"}]'></textarea>
        <div class="admin-actions">
          <button type="button" id="find-source-candidates" class="secondary-btn">Buscar fuente seleccionada</button>
          <button type="button" id="import-candidates" class="primary-btn">Validar e importar candidatos</button>
        </div>
        <p id="candidate-import-status" class="admin-status" role="status" aria-live="polite"></p>
        <div class="candidate-filter-controls">
          <label><span>Puntuación mínima</span><input id="candidate-min-score" type="number" min="0" max="100" value="70" /></label>
          <label><span>Descuento mínimo verificable (%)</span><input id="candidate-min-discount" type="number" min="0" max="100" value="20" /></label>
          <label><span>Precio máximo (€; opcional)</span><input id="candidate-max-price" type="number" min="0.01" step="0.01" /></label>
          <label><span>Categorías (slugs separadas por comas; opcional)</span><input id="candidate-categories" type="text" placeholder="tecnologia, hogar" /></label>
        </div>
        <div id="found-candidates-list" class="candidate-results" aria-live="polite"></div>
        <h3>Historial local de búsquedas</h3>
        <p>Se conserva en este navegador, con precio y estado observados; no se sincroniza ni sustituye una serie histórica oficial.</p>
        <div id="candidate-history-list" class="candidate-results"></div>
      </section>

      <section class="admin-records" aria-labelledby="offers-heading">
        <h2 id="offers-heading">Ofertas del navegador</h2>
        <label class="admin-filter" for="offer-filter">
          Filtrar ofertas
          <select id="offer-filter">
            <option value="all">Todas</option>
            <option value="draft">Borradores</option>
            <option value="verified">Verificadas</option>
            <option value="published">Publicadas</option>
            <option value="expired">Caducadas</option>
          </select>
        </label>
        <div id="offer-list" class="admin-record-list"></div>
      </section>

      <dialog id="telegram-send-dialog" class="telegram-confirmation" aria-labelledby="telegram-confirmation-title">
        <h2 id="telegram-confirmation-title">Previsualización de Telegram</h2>
        <pre id="telegram-preview"></pre>
        <p>¿Enviar esta oferta al canal de Telegram?</p>
        <div class="admin-actions">
          <button type="button" id="cancel-telegram-send" class="secondary-btn">Cancelar</button>
          <button type="button" id="confirm-telegram-send" class="primary-btn">Confirmar envío</button>
        </div>
      </dialog>
    </div>
  </section>
  ) : (
    <section class="section narrow-section">
      <div class="container prose-box">
        <span class="eyebrow">Herramienta local</span>
        <h1>Panel no disponible en producción</h1>
        <p>El administrador solo funciona en modo de desarrollo en tu equipo. No se incluye en la web publicada.</p>
      </div>
    </section>
  )}

  <script>
    if (import.meta.env.DEV || import.meta.env.PUBLIC_ADMIN_PANEL === 'true') {
      const { initializeLocalOfferManager } = await import('../scripts/admin');
      initializeLocalOfferManager();
    }
  </script>
</Layout>
