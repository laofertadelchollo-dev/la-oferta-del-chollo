---
import Layout from '../layouts/Layout.astro';
import OfferCard from '../components/OfferCard.astro';
import { offers as offersData } from '../data/offers';
import { getOfferDiscount, isOfferVisible } from '../lib/site';

const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim().toLocaleLowerCase('es-ES');
const category = url.searchParams.get('category') || 'all';
const store = url.searchParams.get('store') || 'all';
const price = Number(url.searchParams.get('price') || '0');
const discount = Number(url.searchParams.get('discount') || '0');
const sort = url.searchParams.get('sort') || 'recent';

const visibleOffers = offersData.filter((offer) => isOfferVisible(offer, import.meta.env.DEV));
let items = [...visibleOffers];

if (q) {
  items = items.filter((offer) =>
    `${offer.title} ${offer.description} ${offer.store} ${offer.seller || ''} ${offer.tags.join(' ')}`.toLocaleLowerCase('es-ES').includes(q)
  );
}

if (category !== 'all') {
  items = items.filter((offer) => offer.category === category);
}

if (store !== 'all') {
  items = items.filter((offer) => offer.store === store);
}

if (price > 0) {
  items = items.filter((offer) => offer.currentPrice <= price);
}

if (discount > 0) {
  items = items.filter((offer) => getOfferDiscount(offer) >= discount);
}

switch (sort) {
  case 'discount':
    items = [...items].sort((a, b) => getOfferDiscount(b) - getOfferDiscount(a));
    break;
  case 'price':
    items = [...items].sort((a, b) => a.currentPrice - b.currentPrice);
    break;
  case 'featured':
    items = [...items].sort((a, b) => Number(b.featured) - Number(a.featured));
    break;
  default:
    items = [...items].sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
}

const categories = [...new Set(visibleOffers.map((offer) => offer.category))];
const stores = [...new Set(visibleOffers.map((offer) => offer.store))];
---

<Layout title="Ofertas" description="Busca, filtra y compara ofertas activas por categoría, tienda, descuento y precio.">
  <section class="section narrow-section">
    <div class="container">
      <span class="eyebrow">Portal de ofertas</span>
      <h1>Encuentra ofertas con criterio</h1>
      <form class="filters-form" method="get" action="/ofertas/" data-offer-filters>
        <div class="filter-grid">
          <label>
            <span>Buscar</span>
            <input type="search" name="q" value={q} placeholder="Ej. auriculares" />
          </label>
          <label>
            <span>Categoría</span>
            <select name="category">
              <option value="all">Todas</option>
              {categories.map((categoryValue) => (
                <option value={categoryValue} selected={categoryValue === category}>{categoryValue}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Tienda</span>
            <select name="store">
              <option value="all">Todas</option>
              {stores.map((storeValue) => (
                <option value={storeValue} selected={storeValue === store}>{storeValue}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Precio máximo</span>
            <input type="number" name="price" min="0" value={price || ''} placeholder="Ej. 100" />
          </label>
          <label>
            <span>Descuento mínimo</span>
            <input type="number" name="discount" min="0" max="100" value={discount || ''} placeholder="Ej. 30" />
          </label>
          <label>
            <span>Ordenar por</span>
            <select name="sort">
              <option value="recent" selected={sort === 'recent'}>Más recientes</option>
              <option value="discount" selected={sort === 'discount'}>Mayor descuento</option>
              <option value="price" selected={sort === 'price'}>Precio menor</option>
              <option value="featured" selected={sort === 'featured'}>Destacadas</option>
            </select>
          </label>
        </div>
        <div class="filter-actions">
          <button type="submit" class="primary-btn">Aplicar filtros</button>
          <a href="/ofertas/" class="secondary-btn">Limpiar</a>
        </div>
      </form>
    </div>
  </section>

  <section class="section alt-section">
    <div class="container">
      <div class="results-summary" data-offer-count aria-live="polite">
        <strong>{items.length}</strong> ofertas activas
      </div>
      <div class="offer-grid four-up" data-offer-results>
        {items.map((offer) => <OfferCard offer={offer} />)}
      </div>
      <p class="empty-state" data-empty-results hidden>No hay ofertas que coincidan con tu búsqueda.</p>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/offer-filters';
</script>
